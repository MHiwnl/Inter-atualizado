# Exemplo local apenas. Substitua por uma senha forte no seu arquivo .env.
DB_URL=jdbc:postgresql://localhost:5432/taskgo_db
DB_USERNAME=taskgo_app
DB_PASSWORD=troque-por-uma-senha-local-forte
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
TASKGO_CORS_ALLOWED_ORIGINS=http://localhost:5500
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
